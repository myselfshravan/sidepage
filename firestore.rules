rules_version = '2';

// sidepage denies every client read and write.
//
// All data access goes through trusted server code (Next.js on Vercel) using the
// Firebase Admin SDK, which bypasses these rules. Authorisation lives in one
// place, src/server/auth + src/domain/access, where it is unit- and
// integration-tested. See docs/SECURITY.md.
//
// Any exception added here is a security decision: record it in
// docs/DECISIONS.md and add a test in tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
