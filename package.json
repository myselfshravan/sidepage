{
  "name": "sidepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulated": "firebase emulators:exec --project demo-sidepage --only auth,firestore,storage --ui \"next dev\"",
    "emulators": "firebase emulators:start --project demo-sidepage --only auth,firestore,storage",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:emulated": "firebase emulators:exec --project demo-sidepage --only auth,firestore,storage \"vitest run --project integration --project rules\"",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "grant-author": "tsx scripts/grant-author.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:secrets"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extensions": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@vercel/oidc": "^4.0.6",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "firebase-tools": "15.35.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9"
}
