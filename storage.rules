rules_version = '2';

// Deny-all, for the same reason as firestore.rules: uploads and downloads are
// mediated by the server (signed URLs / an authorising proxy), never by direct
// client access. See docs/SECURITY.md.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
