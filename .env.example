# sidepage environment variables.
# Copy to .env.local and fill in. Never commit real values.
# PUBLIC = shipped to the browser (NEXT_PUBLIC_*). SERVER = server-only.

# ---------------------------------------------------------------------------
# Mode. "1" = local Firebase emulators (no credentials needed). "0" = real project.
# ---------------------------------------------------------------------------
USE_FIREBASE_EMULATORS=1                       # SERVER
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1           # PUBLIC
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080         # SERVER  (delete when USE_FIREBASE_EMULATORS=0)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099     # SERVER  (delete when USE_FIREBASE_EMULATORS=0)
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099  # PUBLIC

# ---------------------------------------------------------------------------
# Firebase project
# Emulators: demo-sidepage. Real dev project: sidepage-c4daa.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-sidepage              # SERVER
FIRESTORE_DATABASE_ID=(default)                # SERVER  (a restore can point this at a new database)

# Firebase web app config: Console → Project settings → General → Your apps → Web app.
# Not secret (protected by Auth settings + App Check), but still per-environment.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key          # PUBLIC
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sidepage.firebaseapp.com  # PUBLIC
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sidepage  # PUBLIC
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app           # PUBLIC

# ---------------------------------------------------------------------------
# Server credentials on Vercel: Workload Identity Federation (no key files).
# Leave empty locally; see docs/DEPLOYMENT.md for the one-time GCP setup.
# ---------------------------------------------------------------------------
GCP_WORKLOAD_IDENTITY_AUDIENCE=                # SERVER  //iam.googleapis.com/projects/<num>/locations/global/workloadIdentityPools/vercel/providers/vercel
GCP_SERVICE_ACCOUNT_EMAIL=                     # SERVER  sidepage-app@sidepage-c4daa.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # PUBLIC  canonical URL (sitemap, metadata)
APP_ORIGINS=                                   # SERVER  extra allowed origins for POSTs, comma-separated
CRON_SECRET=                                   # SERVER  >= 32 chars; `openssl rand -hex 32`
RATE_LIMIT_SALT=                               # SERVER  >= 16 chars; `openssl rand -hex 16`
SESSION_RATE_LIMIT_PER_MIN=20                  # SERVER  sign-ins per IP per minute
NEXT_PUBLIC_STORAGE_ENABLED=0                  # PUBLIC  1 once on Blaze with a Storage bucket
NEXT_PUBLIC_CONTACT_EMAIL=                     # PUBLIC  optional, shown on /contact

# ---------------------------------------------------------------------------
# Analytics (PostHog). Events carry ids only, never written content.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=                       # PUBLIC  project API key (phc_…); empty disables analytics
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # PUBLIC
